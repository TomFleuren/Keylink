    "@keylink/sdk": "workspace:*",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
