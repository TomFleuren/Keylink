{
  "name": "@keylink/widget",
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable enroll and verify widget for Keylink.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/keylink.mjs"
    },
    "./browser": "./dist/keylink.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test $(find src -name '*.test.ts')"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
